# ─────────────────────────────────────────────────────────────────────────────
# Bulk Mailer — Environment Configuration Template
# Copy this file to .env and fill in real values before starting the server.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000                  # TCP port the Express server listens on
NODE_ENV=production        # Use 'development' on dev machines (enables extra logging)

# ── SMTP Relay ────────────────────────────────────────────────────────────────
# Internal SMTP relay — no authentication required on the LAN.
# On dev machines off-LAN, SMTP verify will timeout (non-fatal; server still starts).
SMTP_HOST=smtp.example.com      # IP or hostname of the internal SMTP relay
SMTP_PORT=25               # SMTP port (25 = plain, 587 = STARTTLS, 465 = TLS)
SMTP_SECURE=false          # true only if SMTP_PORT=465 (implicit TLS)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bulkmailer
DB_USER=bulkmailer
DB_PASS=changeme           # Strong password in production

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required for Bull job queue. Install via: winget install Redis.Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── LDAP / Active Directory ───────────────────────────────────────────────────
# Users must be members of the 'BulkMailer-Users' AD group to log in.
# Leave blank to disable LDAP (local superadmin still works).
LDAP_URL=               # e.g. ldap://dc.example.com
LDAP_BASE_DN=          # e.g. DC=example,DC=com
LDAP_BIND_DN=CN=svc-bulkmailer,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASS=changeme    # Password for the service account
LDAP_REQUIRED_GROUP=BulkMailer-Users   # AD group (CN) users must belong to

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads       # Where uploaded ZIPs and extracted attachments are stored
ATTACHMENT_BASE_PATH=\\\\SERVER\\shared\\attachments
                           # Base UNC path for 'network' attachment mode

# ── Rate Limiting & Batching ──────────────────────────────────────────────────
SEND_DELAY_MS=2000         # Milliseconds to wait between each email send (throttle)
MAX_BATCH_SIZE=500         # Maximum number of recipients per job

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string
                           # Long random string — change before going to production
SESSION_STORE=memory       # 'memory' (default) or 'postgres' (survives server restarts)
                           # To use 'postgres': ensure connect-pg-simple is installed
                           #   and DB_* credentials above are correct.
COOKIE_SECURE=false        # Set to 'true' ONLY when serving over HTTPS.
                           # Leaving this true on a plain HTTP server silently discards
                           # the session cookie, causing 401 on every request after login.

# ── Local Superadmin ──────────────────────────────────────────────────────────
# Bypasses LDAP authentication — works even when the domain controller is unreachable.
# Pick a username and generate a bcrypt hash of your own password (never commit real values).
# To change: run  npm run hash-password <newpassword>  and paste the hash below.
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASS_HASH=<bcrypt-hash-here>
                           # Generate with: npm run hash-password <yourpassword>
LOCAL_ADMIN_DISPLAY_NAME=Super Admin
LOCAL_ADMIN_DEPARTMENT=Admin
