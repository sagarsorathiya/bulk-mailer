{
  "name": "bulk-mailer",
  "version": "1.0.0",
  "description": "Self-hosted web portal for sending bulk personalised emails with individually mapped file attachments",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently --names \"SERVER,WORKER\" --prefix-colors \"cyan,yellow\" \"nodemon server.js\" \"node services/jobProcessor.js\"",
    "start:all": "concurrently --names \"SERVER,WORKER\" --prefix-colors \"cyan,yellow\" \"node server.js\" \"node services/jobProcessor.js\"",
    "migrate": "node db/migrate.js",
    "worker": "node services/jobProcessor.js",
    "hash-password": "node scripts/hash-password.js",
    "redis:start": "Start-Process -FilePath \"C:\\Program Files\\Redis\\redis-server.exe\" -ArgumentList \"--port 6379\" -WindowStyle Minimized",
    "redis:stop": "& \"C:\\Program Files\\Redis\\redis-cli.exe\" shutdown nosave",
    "redis:ping": "& \"C:\\Program Files\\Redis\\redis-cli.exe\" ping"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.0",
    "ioredis": "^5.4.1",
    "ldapjs": "^3.0.7",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "quill": "^1.3.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.4"
  },
  "keywords": [
    "bulk-mail",
    "email",
    "hr",
    "form16",
    "tds",
    "internal-tool"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true
}
